.profile-page {
  padding-top: calc(164rpx + env(safe-area-inset-top));
}

.profile-card {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e6e4df;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, .035);
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #171717;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-sub {
  margin-top: 10rpx;
  color: #747474;
  font-size: 24rpx;
  line-height: 1.45;
}

.login-panel {
  margin-top: 30rpx;
}

.login-btn {
  height: 88rpx;
  line-height: 88rpx;
}

.login-note {
  margin-top: 16rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 28rpx;
}

.nickname-editor {
  margin-top: 28rpx;
}

.nickname-title {
  font-size: 28rpx;
  font-weight: 900;
}

.nickname-tip {
  margin: 8rpx 0 16rpx;
  color: #747474;
  font-size: 22rpx;
  line-height: 1.45;
}

.nickname-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 1rpx solid #e2e0da;
  background: #fbfaf7;
  font-size: 26rpx;
  font-weight: 700;
}

.nickname-actions {
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.nickname-actions .soft-btn,
.nickname-actions .primary {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.profile-actions .soft-btn,
.profile-actions .ghost-btn {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.ghost-btn {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid #e2e0da;
  background: #ffffff;
  color: #5f5f5f;
  font-weight: 800;
}

.ghost-btn::after {
  border: 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.stat-card:first-child {
  grid-column: 1 / -1;
}

.stat-card {
  min-width: 0;
  padding: 22rpx 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e6e4df;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, .025);
}

.stat-card text {
  display: block;
  color: #777777;
  font-size: 21rpx;
  font-weight: 700;
}

.stat-card strong {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.entry-item {
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f4f3f0;
  color: #171717;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-item.qr-entry {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, #256bff15, #6366f115);
  border: 1rpx solid #256bff30;
  color: #256bff;
}
