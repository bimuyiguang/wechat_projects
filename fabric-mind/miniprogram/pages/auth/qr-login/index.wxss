/* 全屏容器 */
.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(37, 107, 255, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

/* 图标圆圈 */
.icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.success-icon { background: linear-gradient(135deg, #10b981, #059669); }
.error-icon   { background: linear-gradient(135deg, #ef4444, #dc2626); }
.hint-icon    { background: linear-gradient(135deg, #6366f1, #8b5cf6); }

.icon-text {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 900;
  line-height: 1;
}

/* 旋转动画 */
.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #256bff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 8rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 文字 */
.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #111827;
  text-align: center;
  margin-top: 4rpx;
}
.sub {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}

/* 用户预览 */
.user-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 20rpx 32rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #e5e7eb;
}
.user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}

/* 输入框 */
.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
  background: #f9fafb;
  margin-top: 8rpx;
}

/* 按钮 */
.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  border: none;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary {
  background: linear-gradient(135deg, #256bff, #6366f1);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(37, 107, 255, 0.30);
}
.btn-secondary {
  background: #f3f4f6;
  color: #6b7280;
  margin-top: 16rpx;
}
